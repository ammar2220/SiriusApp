import { supabase } from '../cloud/supabaseClient';
import { DeviceRepository } from '../deviceRepository';
import { Home, Room, SiriusDevice } from '../../types/home';
import {
  CloudHome,
  CloudRoom,
  CloudDevice,
  CloudChannel,
  CloudProfile
} from '../../types/cloud';
import AsyncStorage from '@react-native-async-storage/async-storage';

export class CloudDeviceRepository implements DeviceRepository {

  async getProfile(): Promise<CloudProfile | null> {
    const { data, error } = await supabase
      .from('profiles')
      .select('*')
      .single();

    if (error) {
      console.error('[CloudRepo] Error fetching profile:', error);
      return null;
    }
    return data;
  }

  async getHomes(): Promise<Home[]> {
    const { data: { user } } = await supabase.auth.getUser();
    const userId = user?.id;

    if (!userId) {
      console.error('[CloudRepo] No authenticated user found for getHomes');
      return [];
    }

    const { data, error } = await supabase
      .from('homes')
      .select('*, rooms(*)')
      .eq('owner_id', userId);

    if (error) {
      console.error('[CloudRepo] Error fetching homes:', error);
      throw error;
    }

    return (data || []).map(h => ({
      id: h.id,
      userId: h.owner_id,
      name: h.name,
      rooms: (h.rooms || []).map((r: any) => ({
        id: r.id,
        name: r.name,
        type: r.type,
        homeId: h.id,
        devices: [],
      })),
    }));
  }

  async getHome(id: string, userId: string): Promise<Home> {
    const { data, error } = await supabase
      .from('homes')
      .select('*, rooms(*)')
      .eq('id', id)
      .single();

    if (error || !data) {
      throw new Error(`Home ${id} not found or access denied.`);
    }

    return {
      id: data.id,
      userId: data.owner_id,
      name: data.name,
      rooms: (data.rooms || []).map((r: any) => ({
        id: r.id,
        name: r.name,
        type: r.type,
        homeId: data.id,
        devices: [],
      })),
    };
  }

  async addHome(userId: string, name: string): Promise<Home> {
    const { data, error } = await supabase
      .from('homes')
      .insert({ owner_id: userId, name })
      .select()
      .single();

    if (error) {
      console.error('[CloudRepo] addHome failed:', {
        code: error.code,
        message: error.message,
        details: error.details,
        hint: error.hint,
      });
      throw error;
    }

    return {
      id: data.id,
      userId: data.owner_id,
      name: data.name,
      rooms: [],
    };
  }

  async renameHome(homeId: string, newName: string): Promise<void> {
    const { error } = await supabase
      .from('homes')
      .update({ name: newName })
      .eq('id', homeId);

    if (error) throw error;
  }

  async deleteHome(homeId: string): Promise<void> {
    const { error } = await supabase
      .from('homes')
      .delete()
      .eq('id', homeId);

    if (error) throw error;
  }

  async addRoom(homeId: string, name: string, type: string): Promise<Room> {
    const { data, error } = await supabase
      .from('rooms')
      .insert({ home_id: homeId, name, type })
      .select()
      .single();

    if (error) {
      console.error('[CloudRepo] addRoom failed:', {
        code: error.code,
        message: error.message,
        details: error.details,
        hint: error.hint,
      });

      // If it's an RLS failure (403 or specific PG code), we provide a clearer error
      if (error.code === '42501') {
        throw new Error(`Permission denied adding room to home ${homeId}. Ensure you are the owner or a member of the home.`);
      }

      throw error;
    }

    return {
      id: data.id,
      name: data.name,
      type: data.type,
      homeId: data.home_id,
      devices: [],
    };
  }

  async renameRoom(homeId: string, roomId: string, newName: string): Promise<void> {
    const { error } = await supabase
      .from('rooms')
      .update({ name: newName })
      .eq('id', roomId);

    if (error) throw error;
  }

  async deleteRoom(homeId: string, roomId: string): Promise<void> {
    const { error } = await supabase
      .from('rooms')
      .delete()
      .eq('id', roomId);

    if (error) throw error;
  }

  async getDevice(id: string): Promise<SiriusDevice> {
    const { data, error } = await supabase
      .from('devices')
      .select('*, rooms(home_id)')
      .eq('id', id)
      .single();

    if (error || !data) throw new Error(`Device ${id} not found in cloud.`);

    return {
      factoryId: data.factory_id,
      displayName: data.name,
      ipAddress: '',
      powerState: 'unknown',
      rssi: 0,
      connectionStatus: 'offline',
      firmwareVersion: 'unknown',
      roomId: data.room_id,
      homeId: data.rooms?.home_id || '',
      type: 'relay',
      product: {
        code: data.product_code || 'SIRIUS_SWITCH_1CH',
        name: 'Sirius Switch',
        channelCount: data.channel_count,
        capabilities: ['switch'],
      },
      channels: [],
      lastSeen: null,
    } as any;
  }

  async getDevicesInRoom(homeId: string, roomId: string): Promise<SiriusDevice[]> {
    const { data, error } = await supabase
      .from('devices')
      .select('*')
      .eq('room_id', roomId);

    if (error) throw error;

    return (data || []).map(d => ({
      factoryId: d.factory_id,
      displayName: d.name,
      ipAddress: '',
      powerState: 'unknown',
      rssi: 0,
      connectionStatus: 'offline',
      firmwareVersion: 'unknown',
      roomId: d.room_id,
      homeId: homeId,
      type: 'relay',
      product: {
        code: d.product_code || 'SIRIUS_SWITCH_1CH',
        name: 'Sirius Switch',
        channelCount: d.channel_count,
        capabilities: ['switch'],
      },
      channels: [],
      lastSeen: null,
    })) as any[];
  }

  async addDevice(homeId: string, roomId: string, name: string, factoryId: string): Promise<SiriusDevice> {
    const { data, error } = await supabase
      .from('devices')
      .insert({
        room_id: roomId,
        name,
        factory_id: factoryId,
        channel_count: 1 // Default to 1CH for now, can be updated via /api/info
      })
      .select()
      .single();

    if (error) throw error;

    return {
      factoryId: data.factory_id,
      displayName: data.name,
      ipAddress: '',
      powerState: 'unknown',
      rssi: 0,
      connectionStatus: 'offline',
      firmwareVersion: 'unknown',
      roomId: data.room_id,
      homeId: homeId,
      type: 'relay',
      product: {
        code: 'SIRIUS_SWITCH_1CH',
        name: 'Sirius Switch',
        channelCount: 1,
        capabilities: ['switch'],
      },
      channels: [],
      lastSeen: null,
    } as any;
  }

  async removeDevice(deviceId: string): Promise<void> {
    const { error } = await supabase
      .from('devices')
      .delete()
      .eq('id', deviceId);

    if (error) throw error;
  }

  async renameDevice(deviceId: string, newName: string): Promise<void> {
    const { error } = await supabase
      .from('devices')
      .update({ name: newName })
      .eq('id', deviceId);

    if (error) throw error;
  }

  async moveDevice(deviceId: string, newRoomId: string, newHomeId: string): Promise<void> {
    const { error } = await supabase
      .from('devices')
      .update({ room_id: newRoomId })
      .eq('id', deviceId);

    if (error) throw error;
  }

  async setChannelState(deviceId: string, channelId: string, state: 'on' | 'off'): Promise<{ success: boolean, newState: 'on' | 'off' }> {
    throw new Error('CloudRepository does not handle physical device control.');
  }

  async getState(deviceId: string): Promise<SiriusDevice> {
    return this.getDevice(deviceId);
  }
}

export default new CloudDeviceRepository();
```

